{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",
  "ReverseProxy": {

    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5011"
          }
        }
      },
      "dictionary-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:5021"
          }
        }
      },
      //"ai-cluster": {
      //  "Destinations": {
      //    "destination1": {
      //      "Address": "https://localhost:5031"
      //    }
      //  }
      //}
    },

    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "user-api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "dictionary-route": {
        "ClusterId": "dictionary-cluster",
        "Match": {
          "Path": "dictionary-api/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      //"ai-route": {
      //  "ClusterId": "ai-cluster",
      //  "Match": {
      //    "Path": "ai-api/{**catch-all}"
      //  },
      //  "Transforms": [
      //    { "PathPattern": "{**catch-all}" }
      //  ]
      //}
    }
  }
}
